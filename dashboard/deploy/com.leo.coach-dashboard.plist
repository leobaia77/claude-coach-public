<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.leo.coach-dashboard</string>

  <!-- Run the production server (serves built dist/ + /api on one port) via tsx -->
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/YOUR_USERNAME/Claude-coach/dashboard/node_modules/tsx/dist/cli.mjs</string>
    <string>server/index.ts</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/YOUR_USERNAME/Claude-coach/dashboard</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PORT</key>
    <string>8787</string>
    <key>NODE_ENV</key>
    <string>production</string>
  </dict>

  <!-- Start at login, restart if it ever crashes = always-on -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/Claude-coach/dashboard/logs/coach.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/Claude-coach/dashboard/logs/coach.err.log</string>
</dict>
</plist>
