# Copy to dashboard/.env on each machine and fill in real values. NEVER commit .env.
# Anthropic API key for the dashboard chat agent (console.anthropic.com).
ANTHROPIC_API_KEY=sk-ant-...
# Model the dashboard chat uses (account has the Claude 4.x family).
COACH_MODEL=claude-sonnet-4-6

# --- Multi-user (Phase 1+) ---
# openssl rand -hex 32 for each:
MASTER_ENCRYPTION_KEY=
BETTER_AUTH_SECRET=
# First signup with this email becomes admin:
ADMIN_EMAIL=
# Public base URL (Railway domain in prod):
APP_URL=http://localhost:8787

# --- Multi-user (Phase 1+) ---
# openssl rand -hex 32 for each:
MASTER_ENCRYPTION_KEY=
BETTER_AUTH_SECRET=
